# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/rdsgroup

# Email (Nodemailer — use port 587 STARTTLS, NOT 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_TO=info@rdsgroupp.in

# CORS — comma-separated, no spaces
ALLOWED_ORIGINS=https://rdsgroupp.in,https://www.rdsgroupp.in,https://rds-hire.vercel.app,http://localhost:5173

# App
PORT=5000
NODE_ENV=production
